"""二次元 LoRA 测试：zimage+zanime 对照 + Illustrious 工作流提交"""
import sys, os, time, json, urllib.request

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
BASE = "https://www.runninghub.ai"

# ============ 1. zimage + Z-Anime04 ============
print("========== 1. zimage zanime 对照 ==========", flush=True)
sys.path.insert(0, "/data/data/com.ai.assistance.operit/files/workspace/runninghub/scripts")
import rh_zimage_api as Z
Z.API_KEY = KEY
Z.PROXY = f"{Z.BASE}/proxy/{KEY}"

OUT_ROOT = "/sdcard/Download/Operit/runninghub_app/anime_lora_test"
os.makedirs(OUT_ROOT, exist_ok=True)

# 二次元风格 prompt（跟 LoRA 更搭）
PROMPT_ANIME = ("动漫风格插图，9:16竖版，一位少女全身立绘，长发双麻花辫，"
                "白色吊带背心配牛仔短裤，站在浅灰背景前，正面姿势，"
                "精致二次元画风，赛璐璐上色，高清细节")
W, H = 1080, 1920
SEED = 20261015

for lora, label in [(None, "zimage_none"), ("zanime", "zimage_zanime")]:
    d = os.path.join(OUT_ROOT, label)
    os.makedirs(d, exist_ok=True)
    print(f"\n--- {label} (lora={lora}) ---", flush=True)
    t0 = time.time()
    try:
        res = Z.run(prompt_text=PROMPT_ANIME, width=W, height=H, steps=12,
                    seed=SEED, lora=lora, download_dir=d)
        saved = res.get("saved", [])
        if saved:
            print(f"✅ {label} 完成: {saved[0]} ({time.time()-t0:.0f}s)", flush=True)
        else:
            print(f"⚠️ {label} 无输出", flush=True)
    except Exception as e:
        print(f"❌ {label} 失败: {e}", flush=True)

# ============ 2. Illustrious 工作流（平台现成，4个二次元LoRA）============
print("\n\n========== 2. Illustrious Anime 工作流 ==========", flush=True)

def post(path, body):
    data = json.dumps(body).encode()
    req = urllib.request.Request(f"{BASE}{path}", data=data, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}"})
    return json.loads(urllib.request.urlopen(req, timeout=60).read().decode())

# 拉工作流详情拿 nodeInfoList
det = post("/api/webapp/detail", {"webappId": "2050930923734093825"})
ins = (det.get("data") or {}).get("inputNodes") or []
print(f"inputNodes: {len(ins)} 个")

# 构造 nodeInfoList：改 prompt，其余保持默认（4个二次元LoRA已默认挂载）
node_list = []
for n in ins:
    nid = n.get("nodeId")
    fn = n.get("fieldName")
    fv = n.get("fieldValue")
    if nid == "120" and fn == "text":
        fv = "1girl, long twin braids, white tank top, denim shorts, standing front view, gray studio background, high quality"
    node_list.append({"nodeId": nid, "fieldName": fn, "fieldValue": str(fv) if fv is not None else "None"})

print("提交 Illustrious 任务...", flush=True)
try:
    r = post("/task/openapi/ai-app/run", {
        "webappId": "2050930923734093825",
        "apiKey": KEY,
        "nodeInfoList": node_list,
    })
    data = r.get("data") or {}
    print("提交响应:", json.dumps(r, ensure_ascii=False)[:400], flush=True)
    task_id = data.get("taskId")
    if task_id:
        with open(os.path.join(OUT_ROOT, "illustrious_task_id.txt"), "w") as f:
            f.write(str(task_id))
        print(f"✅ Illustrious 任务已提交: taskId={task_id}", flush=True)
        # 轮询最多 5 分钟
        for i in range(30):
            time.sleep(10)
            o = post("/task/openapi/outputs", {"taskId": task_id, "apiKey": KEY})
            code = o.get("code")
            if code == 0:
                files = o.get("data") or []
                print(f"✅ Illustrious 完成! {len(files)} 个文件", flush=True)
                for f_ in files[:5]:
                    print("  🖼", f_.get("fileUrl", "")[:120], flush=True)
                    # 下载
                    url = f_.get("fileUrl")
                    if url:
                        try:
                            fn = os.path.join(OUT_ROOT, f"illustrious_{i}.png")
                            urllib.request.urlretrieve(url, fn)
                            print(f"    → 已存 {fn}", flush=True)
                        except Exception as e:
                            print(f"    下载失败: {e}", flush=True)
                break
            elif code == 805:
                print("❌ Illustrious 任务失败:", json.dumps(o.get("data"), ensure_ascii=False)[:300], flush=True)
                break
            else:
                print(f"  ...轮询 {i+1}/30 code={code} ({time.time()-t0:.0f}s)", flush=True)
except Exception as e:
    print(f"❌ Illustrious 提交异常: {e}", flush=True)

print("\n全部完成", flush=True)