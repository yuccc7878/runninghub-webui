    ("2049040240022659073", "Z-Anime动漫生图专属"),
]


def get_prompt(workflow_id):
    body = json.dumps({"apiKey": KEY, "workflowId": workflow_id}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/openapi/getJsonApiFormat",
        data=body, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=25).read().decode())
    except Exception as e:
        return None, f"请求失败: {e}"
    if d.get("code") != 0:
        return None, f"code={d.get('code')} {d.get('msg') or d.get('message') or ''}"
    try:
        return json.loads(d["data"]["prompt"]), None
    except Exception as e:
        return None, f"prompt解析失败: {e}"


def extract_loras(prompt):
    """提取所有 LoRA 节点: class_type 含 lora 或 inputs 里有 lora_name"""
    found = []
    for nid, node in (prompt or {}).items():
        ct = str(node.get("class_type", ""))
        ins = node.get("inputs", {}) or {}
        lora_name = ins.get("lora_name") or ""
        if "lora" in ct.lower() or lora_name:
            found.append((nid, ct, lora_name, ins.get("strength_model"), ins.get("strength_clip")))
    return found


print("=== RunningHub 二次元工作流 + LoRA 节点扫描 ===\n")
seen = {}
for wid, name in CANDIDATES:
    prompt, err = get_prompt(wid)
    if err:
        print(f"[{name}] ❌ {err}")
        continue
    loras = extract_loras(prompt)
    print(f"[{name}] ({wid}) 节点数={len(prompt)} LoRA数={len(loras)}")
    for nid, ct, ln, sm, sc in loras:
        sm = sm if sm is not None else "-"
        print(f"    - [{nid}] {ct} | {ln} | strength_model={sm}")
        if ln:
            seen.setdefault(ln, {"count": 0, "in": []})
            seen[ln]["count"] += 1
            seen[ln]["in"].append(name)
    print()

print("\n=== 去重 LoRA 文件清单 ===")
for ln, info in sorted(seen.items(), key=lambda x: -x[1]["count"]):
    print(f"• {ln}  (出现{info['count']}次: {', '.join(info['in'][:3])})")