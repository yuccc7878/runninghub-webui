#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Zimage LoRA 对照测试：同 prompt 同 seed，仅 LoRA 不同，各出一张"""
import sys, time, os
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__))))
import rh_zimage_api as Z

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
Z.API_KEY = KEY
Z.PROXY = f"{Z.BASE}/proxy/{KEY}"

OUT_ROOT = "/sdcard/Download/Operit/runninghub_app/zimage_lora_test"

# 同 prompt 同 seed 只有 LoRA 变
PROMPT = ("超写实真人摄影，9:16竖版，全身照，一个二十多岁东亚中国女性，"
          "棕色双麻花辫垂在胸前两侧，白色吊带背心搭配牛仔短裤，站在纯色浅灰背景前，"
          "正面全身入镜，自然站姿，一手叉腰，柔和棚拍布光，8k高清，真实皮肤纹理")
W, H = 1080, 1920
STEPS = 12
SEED = 20261014   # 固定种子，保证公平对照

TEST_PLAN = [
    (None,       "none_原始对照"),
    ("charm",    "charm_风情万种"),
    ("nofilter", "nofilter_无滤真实"),
    ("flowdpo",  "flowdpo_真实感光影"),
    ("model",    "model_全能模特"),
    ("peach",    "peach_蜜桃臀"),
]

os.makedirs(OUT_ROOT, exist_ok=True)
results = []
print(f"[测试开始] {len(TEST_PLAN)} 张，seed={SEED}，{W}x{H}，steps={STEPS}", flush=True)

for lora, label in TEST_PLAN:
    d = os.path.join(OUT_ROOT, label)
    os.makedirs(d, exist_ok=True)
    print(f"\n===== {label} (lora={lora}) =====", flush=True)
    t0 = time.time()
    try:
        res = Z.run(
            prompt_text=PROMPT,
            width=W, height=H,
            steps=STEPS,
            seed=SEED,
            lora=lora,
            download_dir=d,
        )
        saved = res.get("saved", [])
        # 重命名成可读标签，避免全是随机文件名
        if saved:
            src = saved[0]
            dst = os.path.join(d, f"{label}_seed{SEED}.png")
            if os.path.exists(src) and not os.path.exists(dst):
                os.replace(src, dst)
            results.append((label, dst, os.path.getsize(dst) if os.path.exists(dst) else 0,
                            f"{time.time()-t0:.0f}s", res.get("prompt_id")))
            print(f"✅ {label} 完成: {dst} ({results[-1][2]}B, {results[-1][3]})", flush=True)
        else:
            results.append((label, "无输出", 0, f"{time.time()-t0:.0f}s", res.get("prompt_id")))
            print(f"⚠️ {label} 没有下载到图片", flush=True)
    except Exception as e:
        results.append((label, f"ERROR: {e}", 0, f"{time.time()-t0:.0f}s", None))
        print(f"❌ {label} 失败: {type(e).__name__}: {e}", flush=True)

print("\n\n================ 汇总 ================", flush=True)
for label, path, size, dur, pid in results:
    print(f"• {label:24s} | {dur:>6s} | {size:>8d}B | {path}", flush=True)
print(f"\n输出目录: {OUT_ROOT}", flush=True)