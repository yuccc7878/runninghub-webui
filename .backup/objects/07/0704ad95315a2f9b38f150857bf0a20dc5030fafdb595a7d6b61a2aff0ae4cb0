import sys, os, time

sys.path.insert(0, "/data/data/com.ai.assistance.operit/files/workspace/runninghub/scripts")
import rh_zimage_api as Z

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
Z.API_KEY = KEY
Z.PROXY = f"{Z.BASE}/proxy/{KEY}"

OUT_ROOT = "/sdcard/Download/Operit/runninghub_app/zimage_i2i_user_photo"
os.makedirs(OUT_ROOT, exist_ok=True)

REF = "/storage/emulated/0/Download/Operit/cleanOnExit/attachment_7450602148203055633.png"
print(f"参考图存在: {os.path.exists(REF)} → {REF}\n", flush=True)

prompt_data = "/data/data/com.ai.assistance.operit/files/workspace/runninghub/workflows"
# 通用转二次元 prompt（不写死人物外观，交给参考图）
PROMPT = (
    "保持参考图中的人物长相、姿势和构图不变，转成二次元动漫风格插画。"
    "anime style, anime girl, cel shading, 2d illustration, "
    "精致动漫脸，大眼睛，干净线稿，赛璐璐上色，高清细节"
)

PLAN = [
    ("denoise050_轻度", 0.50),
    ("denoise065_平衡", 0.65),
    ("denoise080_重度", 0.80),
]

W, H = 1080, 1920
STEPS = 12
SEED = 20261018

results = []
print(f"[测试开始] 3 档 denoise，seed={SEED}，参考图=用户照片，LoRA=zanime\n", flush=True)

for label, denoise in PLAN:
    d = os.path.join(OUT_ROOT, label)
    os.makedirs(d, exist_ok=True)
    print(f"===== {label} (denoise={denoise}) =====", flush=True)
    t0 = time.time()
    try:
        res = Z.run(
            prompt_text=PROMPT,
            ref_image_path=REF,
            width=W, height=H,
            steps=STEPS,
            denoise=denoise,
            seed=SEED,
            lora="zanime",
            download_dir=d,
        )
        saved = res.get("saved", [])
        if saved:
            src = saved[0]
            dst = os.path.join(d, f"{label}_seed{SEED}.png")
            if os.path.exists(src) and not os.path.exists(dst):
                os.replace(src, dst)
            results.append((label, dst, os.path.getsize(dst) if os.path.exists(dst) else 0, f"{time.time()-t0:.0f}s"))
            print(f"✅ {label} 完成: {dst} ({results[-1][2]}B, {results[-1][3]})\n", flush=True)
        else:
            results.append((label, "无输出", 0, f"{time.time()-t0:.0f}s"))
            print(f"⚠️ {label} 无输出\n", flush=True)
    except Exception as e:
        results.append((label, f"ERROR: {e}", 0, f"{time.time()-t0:.0f}s"))
        print(f"❌ {label} 失败: {type(e).__name__}: {e}\n", flush=True)

print("\n\n============= 汇总 =============", flush=True)
for label, path, size, dur in results:
    print(f"• {label:20s} | {dur:>6s} | {size:>8d}B | {path}", flush=True)
print(f"\n输出目录: {OUT_ROOT}", flush=True)