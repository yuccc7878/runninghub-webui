#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""修复并重建 EMBEDDED_SCRIPTS：解析现有 JSON，注入 illustrious_t2i，重新序列化写回"""
import json, re, sys

path = "/data/data/com.ai.assistance.operit/files/workspace/runninghub/webui.html"
s = open(path, encoding="utf-8").read()

# 抓 EMBEDDED_SCRIPTS 对象（可能因上次误删闭合括号而损坏）
m = re.search(r'const EMBEDDED_SCRIPTS=(.*?);\nlet SCRIPTS', s, re.S)
if not m:
    print("❌ 找不到 EMBEDDED_SCRIPTS")
    sys.exit(1)

raw = m.group(1)
try:
    d = json.loads(raw)
except json.JSONDecodeError as e:
    print(f"JSON 损坏: {e}，尝试补括号修复...")
    # 上次插入把 EMBEDDED 对象最外层闭合 } 删了，尝试补
    try:
        d = json.loads(raw + "}")
        print("补 } 后解析成功")
    except json.JSONDecodeError as e2:
        print(f"补括号仍失败: {e2}")
        sys.exit(1)

print(f"解析成功，当前脚本: {list(d.keys())}")

# 注入 illustrious_t2i
d["illustrious_t2i"] = {
    "name": "Illustrious 二次元文生图 (T2I)",
    "desc": "WAI-illustrious-SDXL 底模 + 可勾选二次元增强 LoRA（Smooth_Booster / Cunnystyle）。半写实 CG 动漫风",
    "module": "rh_illustrious_api", "mode": "t2i",
    "params": [
        {"k": "resolution", "label": "分辨率", "type": "select", "options": [
            {"v": "936x1368", "label": "936×1368（竖屏 9:16 · 推荐）"},
            {"v": "768x1344", "label": "768×1344（竖屏 9:16 · 低清）"},
            {"v": "1080x1920", "label": "1080×1920（竖屏 9:16 · 高清，更贵）"},
            {"v": "1216x832", "label": "1216×832（横屏 16:9）"},
            {"v": "1024x1024", "label": "1024×1024（方形 1:1）"},
        ], "def": "936x1368"},
        {"k": "steps", "label": "步数", "type": "int", "def": 20},
        {"k": "cfg", "label": "CFG", "type": "float", "def": 2.0, "help": "Illustrious 系建议 2.0 左右"},
        {"k": "smooth", "label": "画质增强 Smooth_Booster", "type": "lora", "def": True, "def_strength": 0.9, "help": "画质平滑/细节增强（Illustrious 系）"},
        {"k": "cunnystyle", "label": "二次元风格 Cunnystyle", "type": "lora", "def": True, "def_strength": 0.8, "help": "二次元动漫风格（Illustrious 系）"},
        {"k": "seed", "label": "随机种子", "type": "text", "def": "", "placeholder": "留空 = 随机", "group": "advanced"},
    ],
}

# 紧凑序列化（保持原格式风格）
new_obj = json.dumps(d, ensure_ascii=False, separators=(",", ":"))
# 重建整行
new_line = "const EMBEDDED_SCRIPTS=" + new_obj + ";\nlet SCRIPTS"
s = s[:m.start()] + new_line + s[m.end():]

open(path, "w", encoding="utf-8").write(s)
print(f"✅ 重建完成，脚本数: {len(d)}")
print("  illustrious_t2i 已注入")

# 验证
s2 = open(path, encoding="utf-8").read()
m2 = re.search(r'const EMBEDDED_SCRIPTS=(.*?);\nlet SCRIPTS', s2, re.S)
d2 = json.loads(m2.group(1))
print(f"✅ 二次验证 JSON OK, 脚本: {list(d2.keys())}")
zl = [p for p in d2["zimage_i2i"]["params"] if p["k"] == "lora"][0]
print("  zimage lora 选项:", [o["v"] for o in zl["options"]])