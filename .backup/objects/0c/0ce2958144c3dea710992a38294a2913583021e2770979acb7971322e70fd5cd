# -*- coding: utf-8 -*-
"""深挖 Illustrious 系列 + Z-Anime 工作流 的完整 inputNodes（看 lora 节点）"""
import json
import urllib.request

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
BASE = "https://www.runninghub.ai"

TARGETS = [
    ("2050930923734093825", "Illustrious _ Anime(WAI-illustrious-SDXL)"),
    ("2053014947591925762", "Illustrious超真实_无限制"),
    ("2050898997623173121", "Illustrious亚洲女性写实"),
    ("2070514017013166081", "illustrious 文生图工作流 高清放大"),
    ("2029051908509405186", "illustrious-3D-CG风格YunY-海边"),
    ("2064573442862698497", "Illustrious科幻机甲"),
]


def get_detail(wid):
    body = json.dumps({"webappId": wid}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/webapp/detail", data=body, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=25).read().decode())
        return d.get("data") or {}, None
    except Exception as e:
        return None, str(e)


all_files = {}
for wid, name in TARGETS:
    detail, err = get_detail(wid)
    if err:
        print(f"[{name}] ❌ {err}")
        continue
    ins = detail.get("inputNodes") or []
    lora_nodes = []
    all_nodes = []
    for n in ins:
        fv = str(n.get("fieldValue") or "")
        nn = str(n.get("nodeName") or "")
        fn = str(n.get("fieldName") or "")
        all_nodes.append(f"{nn}/{fn}")
        if "lora" in (nn + fn).lower() or ".safetensors" in fv:
            lora_nodes.append((nn, fn, fv))
    print(f"[{name}] ({wid}) 输入节点 {len(ins)} 个 | LoRA相关 {len(lora_nodes)}")
    for nn, fn, fv in lora_nodes[:10]:
        print(f"    - 🎯 {nn}/{fn} = {fv}")
        if fv.strip().endswith(".safetensors"):
            all_files.setdefault(fv.strip(), []).append(name)
    # 顺带列出所有含 .safetensors 当前值的节点（可能藏在 model/vae 里）
    for n in ins:
        fv = str(n.get("fieldValue") or "")
        if fv.strip().endswith(".safetensors") and fv not in [x[2] for x in lora_nodes]:
            print(f"    - 📦 {n.get('nodeName')}/{n.get('fieldName')} = {fv}")
            all_files.setdefault(fv.strip(), []).append(name)
    print()

print("\n=== 汇总: 二次元/动漫相关模型文件 ===")
for f, ins in sorted(all_files.items(), key=lambda x: -len(x[1])):
    print(f"• {f}  ({', '.join(dict.fromkeys(ins))})")