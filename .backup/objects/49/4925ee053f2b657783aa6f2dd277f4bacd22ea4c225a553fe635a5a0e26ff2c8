def get_detail(webapp_id):
    body = json.dumps({"webappId": webapp_id}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/webapp/detail",
        data=body, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=25).read().decode())
        return d.get("data") or {}, None
    except Exception as e:
        return None, f"请求失败: {e}"


def extract_lora_nodes(detail):
    """抓 fieldName 含 lora 的输入节点，列出可选集合"""
    out = []
    ins = detail.get("inputNodes") or []
    for n in ins:
        fn = str(n.get("fieldName") or "")
        nn = str(n.get("nodeName") or "")
        if "lora" not in (fn + nn).lower():
            continue
        fd = n.get("fieldData") or ""
        fv = str(n.get("fieldValue") or "")
        # fieldData 可能是 "[['a','b'], {'default':'a'}]" 或纯字符串
        opts = []
        raw = fd if isinstance(fd, str) else json.dumps(fd, ensure_ascii=False)
        try:
            arr = json.loads(raw)
            if isinstance(arr, list) and arr and isinstance(arr[0], list):
                opts = [str(x) for x in arr[0]]
        except Exception:
            opts = [w.strip() for w in raw.split(",") if w.strip()]
        out.append({
            "node": nn, "field": fn, "type": n.get("fieldType"),
            "current": fv, "options": opts,
        })
    return out


