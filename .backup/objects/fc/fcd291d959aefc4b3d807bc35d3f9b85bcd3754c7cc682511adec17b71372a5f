#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""扫描二次元 webapp 详情的 inputNodes，抓 LoRA 文件名（fieldData 里的 .safetensors）"""
import json
import urllib.request

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
BASE = "https://www.runninghub.ai"

CANDIDATES = [
    ("2075238623930310658", "二次元-文生图"),
    ("2064736900497362945", "Z-Anime-基于ZIB底模的动漫风格模型"),
    ("2060997037902094337", "Z-Anime动漫图片生成"),
    ("2058139430866735105", "z-anime-distill-8step"),
    ("2074050647022125056", "Z-Anime动漫生图专属"),
    ("2049498784266194945", "Z-Anime-自动提示词"),
    ("2049428490881081346", "z_anime+illustrious 细节增强"),
    ("2049120457999257602", "Z-Anime-漫画专用"),
    ("2049114813778890753", "Z-Anime-动漫文生图"),
    ("2049079404013297665", "Z-Anime-高清放大"),
    ("2053379832075042817", "PiPi-Z-image Controlnet 转动漫"),
    ("2052597891260268546", "超顺滑动漫动态壁纸"),
    ("2075177009222864898", "二次元动漫转真人"),
    ("1911791420821438465", "动漫转绘真人风格V3"),
]


def get_detail(webapp_id):
    body = json.dumps({"webappId": webapp_id}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/webapp/detail",
        data=body, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}"},
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=25).read().decode())
    except Exception as e:
        return None, f"请求失败: {e}"
    return d.get("data") or {}, None


def find_lora_refs(detail):
    """在 inputNodes 的所有字段里找 .safetensors / lora 相关"""
    hits = []
    ins = detail.get("inputNodes") or []
    for n in ins:
        fd = n.get("fieldData") or ""
        fv = str(n.get("fieldValue") or "")
        desc = str(n.get("description") or "")
        blob = f"{fd} | {fv} | {desc}"
        if ".safetensors" in blob or "lora" in blob.lower():
            safes = [w for w in blob.replace("[", " ").replace("]", " ").replace('"', " ").split()
                     if ".safetensors" in w]
            hits.append({
                "node": n.get("nodeName"),
                "field": n.get("fieldName"),
                "type": n.get("fieldType"),
                "safetensors": safes,
                "sample": blob[:200],
            })
    return hits


print("=== 二次元 webapp LoRA 引用扫描 ===\n")
all_safes = {}
for wid, name in CANDIDATES:
    detail, err = get_detail(wid)
    if err:
        print(f"[{name}] ❌ {err}")
        continue
    hits = find_lora_refs(detail)
    if not hits:
        print(f"[{name}] ({wid}) 无 LoRA 引用暴露")
        continue
    print(f"[{name}] ({wid}) 命中 {len(hits)} 个节点:")
    for h in hits:
        print(f"    - {h['node']} / {h['field']} ({h['type']})")
        for s in h["safetensors"]:
            print(f"         🎯 {s}")
            all_safes.setdefault(s, []).append(name)
    print()

print("\n=== 汇总: 平台二次元相关 LoRA 文件名 ===")
for s, ins in sorted(all_safes.items(), key=lambda x: -len(x[1])):
    print(f"• {s}   (来自: {', '.join(dict.fromkeys(ins))})")