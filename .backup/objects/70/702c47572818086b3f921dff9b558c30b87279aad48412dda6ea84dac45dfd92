#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""真人→二次元 LoRA 测试：zimage 图生图 + Z-Anime04，用写实照片当真人参考"""
import sys, os, time

sys.path.insert(0, "/data/data/com.ai.assistance.operit/files/workspace/runninghub/scripts")
import rh_zimage_api as Z

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
Z.API_KEY = KEY
Z.PROXY = f"{Z.BASE}/proxy/{KEY}"

OUT_ROOT = "/sdcard/Download/Operit/runninghub_app/zimage_i2i_anime_test"
os.makedirs(OUT_ROOT, exist_ok=True)

# 真人参考图：用之前跑出来的写实图（就当"真人照片"输入）
REF = "/sdcard/Download/Operit/runninghub_app/zimage_prompt_test/写实_基准/写实_基准_seed20261016.png"
print(f"参考图存在: {os.path.exists(REF)} → {REF}\n", flush=True)

# prompt：主体描述保持跟参考图一致，风格词转向二次元
PROMPT = ("同一位少女，棕色双麻花辫，白色吊带背心，牛仔短裤，站在浅灰背景前，"
          "保持原姿势和构图，转成二次元动漫风格插画，anime style, cel shading, "
          "精致动漫脸，大眼睛，干净线稿，赛璐璐上色")

# denoise 梯度：0.45 锁姿势最狠 / 0.6 平衡锁主体 / 0.75 风格化更强
PLAN = [
    ("denoise045_锁姿势", 0.45),
    ("denoise060_平衡",   0.60),
    ("denoise075_风格化", 0.75),
]

W, H = 1080, 1920
STEPS = 12
SEED = 20261017  # 新 seed

results = []
print(f"[测试开始] 3 组 denoise，seed={SEED}，参考图=写实照片，LoRA=zanime\n", flush=True)

for label, denoise in PLAN:
    d = os.path.join(OUT_ROOT, label)
    os.makedirs(d, exist_ok=True)
    print(f"===== {label} (denoise={denoise}) =====", flush=True)
    t0 = time.time()
    try:
        res = Z.run(
            prompt_text=PROMPT,
            ref_image_path=REF,     # 图生图：真人照片输入
            width=W, height=H,
            steps=STEPS,
            denoise=denoise,
            seed=SEED,
            lora="zanime",          # 挂 Z-Anime04
            download_dir=d,
        )
        saved = res.get("saved", [])
        if saved:
            src = saved[0]
            dst = os.path.join(d, f"{label}_seed{SEED}.png")
            if os.path.exists(src) and not os.path.exists(dst):
                os.replace(src, dst)
            results.append((label, dst, os.path.getsize(dst) if os.path.exists(dst) else 0, f"{time.time()-t0:.0f}s"))
            print(f"✅ {label} 完成: {dst} ({results[-1][2]}B, {results[-1][3]})\n", flush=True)
        else:
            results.append((label, "无输出", 0, f"{time.time()-t0:.0f}s"))
            print(f"⚠️ {label} 无输出\n", flush=True)
    except Exception as e:
        results.append((label, f"ERROR: {e}", 0, f"{time.time()-t0:.0f}s"))
        print(f"❌ {label} 失败: {type(e).__name__}: {e}\n", flush=True)

print("\n\n============= 汇总 =============", flush=True)
for label, path, size, dur in results:
    print(f"• {label:24s} | {dur:>6s} | {size:>8d}B | {path}", flush=True)
print(f"\n输出目录: {OUT_ROOT}", flush=True)