#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""深挖 LORA 型输入节点的可选列表 + 追加市场搜索"""
import json
import urllib.request

KEY = "63e1f602f33442b2b21ca7f6e9ac5041"
BASE = "https://www.runninghub.ai"


def post(path, body, headers=None):
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        f"{BASE}{path}", data=data, method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {KEY}",
                 **(headers or {})},
    )
    try:
        return json.loads(urllib.request.urlopen(req, timeout=25).read().decode())
    except Exception as e:
        return {"_err": str(e)}


def get_detail(wid):
    d = post("/api/webapp/detail", {"webappId": wid})
    return d.get("data") or {}, d.get("_err")


print("=== 深挖 LORA 节点 fieldData ===\n")
TARGETS = [
    ("2053379832075042817", "PiPi-Z-image Controlnet 转动漫"),
    ("2052597891260268546", "超顺滑动漫动态壁纸"),
    ("1911791420821438465", "动漫转绘真人风格V3"),
]
all_lora = {}
for wid, name in TARGETS:
    detail, err = get_detail(wid)
    if err:
        print(f"[{name}] ❌ {err}")
        continue
    print(f"[{name}] ({wid})")
    ins = detail.get("inputNodes") or []
    for n in ins:
        fn = str(n.get("fieldName") or "")
        nn = str(n.get("nodeName") or "")
        if "lora" not in (fn + nn).lower():
            continue
        fd = n.get("fieldData")
        fv = n.get("fieldValue")
        print(f"    - {nn}/{fn} | type={n.get('fieldType')} | 当前={fv}")
        print(f"      fieldData: {json.dumps(fd, ensure_ascii=False)[:400]}")
        # 收集当前值 + fieldData 里的文件名
        cands = [str(fv)] if fv else []
        if isinstance(fd, str):
            cands += [x for x in fd.replace('[', ' ').replace(']', ' ').replace('"', ' ').split()
                      if x.strip().endswith('.safetensors')]
        elif isinstance(fd, dict):
            for v in fd.values():
                if isinstance(v, list):
                    cands += [str(x) for x in v if str(x).endswith('.safetensors')]
        for c in cands:
            if c.strip():
                all_lora.setdefault(c.strip(), []).append(name)
    print()

print("\n=== 市场搜索: 画风/lora/增强 ===\n")
for kw in ("lora", "画风", "增强"):
    d = post("/api/webapp/list", {"size": 12, "current": 1, "search": kw})
    recs = (d.get("data") or {}).get("records") or [] if not d.get("_err") else []
    print(f"--- 关键词 '{kw}' 命中 {len(recs)} ---")
    for r in recs[:8]:
        print(f"  - {r.get('id')} {r.get('name')} | 使用 {(r.get('statisticsInfo') or {}).get('useCount')}")
    print()

print("\n=== 汇总: 二次元相关 LoRA 文件 ===")
for f, ins in sorted(all_lora.items(), key=lambda x: -len(x[1])):
    print(f"• {f}   (来自: {', '.join(dict.fromkeys(ins))})")